<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet author="slint" id="add-time-format-to-user-settings">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="user_settings" columnName="time_format"/></not>
    </preConditions>
    <addColumn tableName="user_settings">
      <column name="time_format" type="VARCHAR(10)" defaultValue="HOURS_24">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

</databaseChangeLog>
